## Pizzaz MCP (Python) environment variables
# Note: All variables are optional. With nothing set, the servers default to CDN and sensible defaults.
# PIZZAZ_ASSET_ORIGIN=http://localhost:4444   # Dev/serve origin (leave unset for CDN)
# PIZZAZ_ASSET_HASHED=false                   # false for Vite dev; true for hashed serve (default true)
# PORT=8000                                   # Optional: change server port (default 8000)
